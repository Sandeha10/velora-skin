doctype html
html
  head
    meta(name='viewport', content='width=device-width, initial-scale=1.0')
    meta(http-equiv='Content-Type', content='text/html; charset=UTF-8')
    title= subject
    style.
      body {
        background-color: #F7F7F4;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        -webkit-font-smoothing: antialiased;
        font-size: 15px;
        line-height: 1.6;
        margin: 0;
        padding: 0;
        color: #1C1917;
      }
      .container {
        display: block;
        margin: 0 auto !important;
        max-width: 580px;
        padding: 40px 20px;
      }
      .card {
        background: #FFFFFF;
        border: 1px solid #E7E5E4;
        border-radius: 2px;
        padding: 40px;
      }
      .brand-header {
        text-align: center;
        padding-bottom: 30px;
        border-bottom: 1px solid #F5F5F4;
      }
      .brand-title {
        font-size: 20px;
        letter-spacing: 0.25em;
        text-transform: uppercase;
        font-weight: 500;
        margin: 0;
        color: #064E3B;
      }
      .brand-subtitle {
        font-size: 11px;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        color: #78716C;
        margin-top: 4px;
      }
      .content-body {
        padding: 30px 0;
      }
      .btn-container {
        text-align: center;
        margin: 35px 0;
      }
      .btn {
        background-color: #1C1917;
        color: #FFFFFF !important;
        padding: 14px 30px;
        text-decoration: none;
        letter-spacing: 0.1em;
        font-size: 12px;
        text-transform: uppercase;
        display: inline-block;
        font-weight: 500;
      }
      .footer {
        text-align: center;
        padding-top: 25px;
        font-size: 12px;
        color: #A8A29E;
        line-height: 1.5;
      }
  body
    .container
      .card
        .brand-header
          h1.brand-title Velora Skin
          p.brand-subtitle Minimalist Botanical Luxury
        .content-body
          block content
      .footer
        p © 2026 Velora Skin Laboratory. All rights reserved.
        p Consciously crafted for mindful skincare rituals.